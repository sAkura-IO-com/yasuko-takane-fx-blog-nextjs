# ───────── 基础 ─────────
# 公开站点地址：metadataBase / sitemap / RSS / llms.txt / JSON-LD / IndexNow 的基准。
# 本地不填会回退到 http://localhost:3000。
SITE_URL=http://localhost:3033

# 开发服务器额外允许的来源（LAN IP / 自定义本地域名），逗号分隔。
# 默认只允许 localhost / 127.0.0.1；用手机等其它设备访问时再补。
# DEV_ALLOWED_ORIGINS=192.168.1.10,yasuko-takane-fx-blog.localhost

# ───────── 数据库 ─────────
# 默认走 Neon serverless（Vercel 等无长连接环境），DATABASE_URL 指向 Neon 连接串。
# 本地用标准 TCP 连接时，打开下一行的 DRIZZLE_DRIVER。
DATABASE_URL=postgres://yasuko-takane-fx-blog:123456@localhost:5432/yasuko-takane-fx-blog
# DRIZZLE_DRIVER=node-postgres

# ───────── Better Auth（管理员账号密码登录）─────────
# 会话签名密钥，生产必须设置。生成方式：
#   openssl rand -base64 32
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# 兜底管理员：填 Better Auth 用户 id，逗号分隔。
# 通常不用填——/setup 创建的管理员已写入 role=admin；这里仅作额外放行。
SITE_ADMIN_USER_IDS=

# ───────── GitHub 登录 ─────────
# 两项都留空时不显示 GitHub 登录按钮。回调地址需在 GitHub OAuth App 登记：
#   {SITE_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ───────── 公开 JSON API（/api/v1）─────────
# 额外允许回显的 Origin，逗号分隔。未知 Origin 仍返回 Access-Control-Allow-Origin: *。
# PUBLIC_API_ORIGINS=https://app.yasuko-takane-fx-blog.com,http://localhost:8081

# 评论限流使用的客户端 IP：默认信任 x-real-ip / x-forwarded-for。
# cf-connecting-ip 客户端可伪造，仅当请求确实先经过 Cloudflare 时才打开。
# TRUST_CF_CONNECTING_IP=1

# ───────── IndexNow（Bing 等主动推送）─────────
# 必须与 public/{key}.txt 文件名一致；留空则跳过 IndexNow。
INDEXNOW_KEY=

# ───────── Cloudflare R2（图片库 / 文件）─────────
# 以下五项缺任意一项，媒体上传与读取都会报「R2 图片库未配置」。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yasuko-takane-fx-blog
# 公开访问前缀（绑定域名或 CDN），不要以 / 结尾。
R2_PUBLIC_BASE_URL=https://cdn.example.com

# 可选：S3 兼容端点。不设则为 https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com。
# 本机没有到 R2 的网络时可指向 MinIO，例如 http://127.0.0.1:9000
# R2_ENDPOINT=
# 可选：S3 区域。默认 R2 用 auto，设置了自建端点时用 us-east-1；
# MinIO / RustFS 请显式设为 us-east-1，否则建桶会报 InvalidLocationConstraint。
# R2_REGION=us-east-1
# MinIO 等自建服务需要路径风格；R2 不要开。
# R2_FORCE_PATH_STYLE=1
# 可选：浏览器直传（presigned URL）使用的端点，默认与 R2_ENDPOINT 相同。
# Docker 等「容器内地址 ≠ 宿主机地址」的场景必须单独设为宿主机可访问的地址。
# R2_PUBLIC_ENDPOINT=http://localhost:13818

# R2 桶 CORS：浏览器直传 PUT 需要放行来源与 content-type。
# [
#   {
#     "AllowedOrigins": ["https://yasuko-takane-fx-blog.localhost", "https://your-domain.com"],
#     "AllowedMethods": ["GET", "PUT", "HEAD"],
#     "AllowedHeaders": ["content-type", "*"],
#     "MaxAgeSeconds": 3600
#   }
# ]

# ───────── 后台「配置」入库覆盖 ─────────
# 敏感配置（API key / secret）加密入库用的主密钥（AES-256-GCM 派生）。
# 留空 = 敏感项只能跟随环境变量、无法入库覆盖；更换主密钥会让已入库的敏感项解不开。
# 生成方式同上（openssl rand -base64 32）。
CONFIG_MASTER_KEY=

# ───────── 本地脚本（可选）─────────
# PWA 截图脚本访问的地址，默认 http://localhost:3000
# PWA_SCREENSHOT_URL=