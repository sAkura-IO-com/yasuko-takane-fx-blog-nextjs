{
  "name": "yasuko-takane-fx-blog",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "//": "下面的cloud是生产环境的数据库迁移。需要先建.env.cloud环境变量",
    "dev": "tsx scripts/dev-storage.ts && next dev --port 3033",
    "storage:init": "tsx scripts/dev-storage.ts",
    "build": "next build",
    "start": "next start --port 3033",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "tsx scripts/copy-monaco.ts",
    "db:generate": "drizzle-kit generate",
    "db:dev:migrate": "drizzle-kit migrate",
    "db:dev:studio": "drizzle-kit studio",
    "db:dev:baseline": "node --env-file=.env --import tsx scripts/db-baseline-migration.ts",
    "db:cloud:migrate": "node --env-file=.env.cloud node_modules/drizzle-kit/bin.cjs migrate",
    "auth:generate": "pnpm dlx auth@1.7.0-rc.6 generate --yes --config ./lib/better-auth/auth-cli.ts --output ./db/auth-schema.ts",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@base-ui/react": "^1.6.0",
    "@better-auth/core": "1.7.0-rc.6",
    "@better-auth/drizzle-adapter": "1.7.0-rc.6",
    "@better-auth/i18n": "1.7.0-rc.6",
    "@better-auth/passkey": "1.7.0-rc.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lobehub/icons": "^6.15.0",
    "@modelcontextprotocol/server": "^2",
    "@monaco-editor/react": "^4.7.0",
    "@neondatabase/serverless": "^1.2.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.0",
    "@shikijs/transformers": "^4.4.3",
    "@use-gesture/react": "10.3.1",
    "better-auth": "1.7.0-rc.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "v1.0.0-rc.4",
    "feed": "^6.0.0",
    "hast-util-from-html": "^2.1.0",
    "lucide-react": "^1.24.0",
    "mcp-handler": "^2",
    "monaco-editor": "^0.56.0",
    "motion": "^13.1.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "pele": "^1.12.0",
    "pg": "^8.22.0",
    "pinyin-pro": "^3.29.3",
    "postprocessing": "^6.39.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.13.0",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "sonner": "^2.0.7",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/hast": "^3.0.5",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "oxfmt": "0.68.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^7"
  }
}